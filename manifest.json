{
  "manifest_version": 3,
  "name": "Skip90",
  "version": "0.3.0",
  "description": "Assign your own keys and skip durations for HTML5 videos.",
  "minimum_chrome_version": "119",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Skip90",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start",
      "js": ["config.js", "media.js", "content.js"],
      "css": ["overlay.css"]
    }
  ]
}
